---
import Base from '../layouts/Base.astro';
import MovieGrid from '../components/MovieGrid';
import { site } from '../config/site';
import { loadGridMovies } from '../lib/load';

const movies = loadGridMovies();
---

<Base>
  <h1 class="font-display text-4xl font-bold sm:text-5xl">{site.name}</h1>
  <p class="mt-3 mb-8 max-w-prose text-lg text-muted">{site.tagline}</p>
  <MovieGrid client:load movies={movies} />
</Base>
