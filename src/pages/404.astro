---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page doesn't exist.">
  <h1 class="font-display text-4xl font-bold">That page isn't here</h1>
  <p class="mt-3 max-w-prose text-lg text-muted">
    The link may be old or mistyped. The movie list is one click away.
  </p>
  <a
    href="/"
    class="mt-6 inline-block rounded-full bg-gold px-5 py-3 font-semibold text-[#1a1204] hover:brightness-110"
  >
    Back to the movie list
  </a>
</Base>
