---
// A bar chart made of plain HTML and CSS, no chart library. Every row links to the
// home page with that filter applied, and the same numbers are in a real table below.
import type { Count } from '../lib/stats';

interface Props {
  title: string;
  rows: Count[];
  unit: string; // "movies"
  note?: string;
}

const { title, rows, unit, note } = Astro.props;
const max = Math.max(1, ...rows.map((r) => r.count));
---

<section class="rounded-2xl border border-line bg-panel p-5">
  <h2 class="font-display text-xl font-bold">{title}</h2>
  {note && <p class="mt-1 text-sm text-muted">{note}</p>}

  <ul class="mt-4 space-y-1">
    {
      rows.map((row) => (
        <li>
          <a
            href={row.href}
            class="group grid grid-cols-[minmax(0,8.5rem)_minmax(0,1fr)_2.5rem] items-center gap-3 rounded-lg px-1 py-1.5 hover:bg-panel-2 sm:grid-cols-[minmax(0,11rem)_minmax(0,1fr)_2.5rem]"
          >
            <span class="truncate text-sm text-text group-hover:text-gold" title={row.name}>
              {row.name}
            </span>
            <span class="h-3 rounded-full bg-ink" aria-hidden="true">
              <span class="block h-full rounded-full bg-gold" style={`width: ${(row.count / max) * 100}%`} />
            </span>
            <span class="text-right text-sm tabular-nums text-muted">
              {row.count}
              <span class="sr-only"> {unit}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <details class="mt-4">
    <summary class="inline-block cursor-pointer py-2 text-sm font-medium text-gold underline underline-offset-4">
      Show these numbers as a table
    </summary>
    <table class="mt-3 w-full text-sm">
      <caption class="sr-only">{title}</caption>
      <thead>
        <tr class="border-b border-line text-left text-muted">
          <th scope="col" class="py-2 pr-4 font-medium">Name</th>
          <th scope="col" class="py-2 text-right font-medium">Number of {unit}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-b border-line/60">
              <th scope="row" class="py-2 pr-4 text-left font-normal">
                <a href={row.href} class="inline-block py-1 text-text underline underline-offset-4 hover:text-gold">
                  {row.name}
                </a>
              </th>
              <td class="py-2 text-right tabular-nums text-muted">{row.count}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</section>
